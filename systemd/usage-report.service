[Unit]
Description=Usage report quota collector and authenticated read-only query service
After=local-fs.target

[Service]
Type=simple
User=root
UMask=0077
RuntimeDirectory=usage-report
RuntimeDirectoryMode=0755
EnvironmentFile=-/etc/default/usage-report
ExecStart=/usr/local/libexec/usage-report serve $USAGE_REPORT_ADMIN_ARGS
Restart=on-failure
RestartSec=5
NoNewPrivileges=true
RestrictAddressFamilies=AF_UNIX
MemoryMax=512M
TasksMax=64

[Install]
WantedBy=multi-user.target
